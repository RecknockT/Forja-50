<Window x:Class="MiIALocal.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Forja 50 · RTX 3090, 5070 Ti y 5080" Icon="Assets/app.ico" Width="1240" Height="820" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#101820" Foreground="#E2ECF1" FontFamily="Segoe UI">
  <Grid Background="#101820">
    <Grid.ColumnDefinitions><ColumnDefinition Width="272"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#0D151C" Padding="24,28">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/logo.png" Width="36" Height="36" Margin="0,0,10,0"/><TextBlock Text="Forja 50" Foreground="White" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="CÓDIGO LOCAL · RTX 3090 / 5070 Ti / 5080" Foreground="#9FB8BE" FontSize="10" Margin="0,8,0,32"/><TextBlock x:Name="ProjectSectionLabel" Text="PROYECTO" Foreground="#9FB8BE" FontSize="11" FontWeight="SemiBold"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="MODO DE USO" FontSize="11" Foreground="#9FB8BE" Margin="0,8,0,8"/><ComboBox x:Name="WorkspaceChoice" SelectionChanged="WorkspaceChoice_SelectionChanged" Margin="0,0,0,18"><ComboBoxItem Content="Programación"/><ComboBoxItem Content="Imágenes y animación"/></ComboBox><StackPanel x:Name="ProjectArea"><TextBlock x:Name="ProjectName" Text="Elegí dónde trabajar" Foreground="White" FontSize="18" Margin="0,12,0,6"/><TextBlock x:Name="ProjectPathLabel" Text="Tus archivos permanecen en su carpeta original." Foreground="#B4C9CE" FontSize="12"/><Button x:Name="ProjectButton" Content="Elegir proyecto" Margin="0,18,0,24" Click="ChooseProject_Click"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Top"><TextBlock Text="EN ESTE EQUIPO" Foreground="#9FB8BE" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="GpuLabel" Text="Detectando tu placa..." Foreground="White" Margin="0,12,0,6" FontSize="15"/><TextBlock x:Name="RamLabel" Foreground="#B4C9CE" FontSize="12"/><Border Background="#18232C" CornerRadius="8" Padding="12" Margin="0,14,0,0"><StackPanel><TextBlock Text="VRAM DE LA PLACA" Foreground="#9FB8BE" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="VramUsage" Text="Consultando memoria..." Foreground="#E2ECF1" FontSize="12" Margin="0,8,0,6"/><ProgressBar x:Name="VramBar" Height="5" Maximum="100" Background="#263743" Foreground="#5BD3BD"/><TextBlock x:Name="VramTotal" Foreground="#9FB8BE" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border><Expander x:Name="ConfigurationExpander" Header="Configuración del modo" Foreground="#E2ECF1" IsExpanded="True" Margin="0,20,0,18"><Border Background="#23434B" CornerRadius="8" Padding="12" Margin="0,8,0,0"><ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ConfigurationSummary" Foreground="#B4C9CE" FontSize="11" LineHeight="16"/></ScrollViewer></Border></Expander></StackPanel>
        <StackPanel Grid.Row="3"><Button x:Name="GitHubButton" Content="Cuenta de GitHub" Click="GitHub_Click" Margin="0,0,0,10" Background="#23434B" Foreground="White"/><Button x:Name="StorageButton" Content="Administrar almacenamiento" Click="Storage_Click" Margin="0,0,0,10" Background="#23434B" Foreground="White"/><Button x:Name="AdvancedButton" Content="Configuración avanzada" Click="Advanced_Click" Margin="0,0,0,10" Padding="8,10" Background="#23434B" Foreground="White"/><Button Content="Diagnóstico y registros" Margin="0,0,0,10" Click="Logs_Click" Background="#23434B" Foreground="White"/><Button x:Name="UpdateButton" Content="Buscar actualizaciones" Click="Update_Click" Margin="0,0,0,6" Background="#23434B" Foreground="White"/><Button Content="Versiones en GitHub" Click="Versions_Click" Margin="0,0,0,10" Background="#23434B" Foreground="White"/><TextBlock Text="Versión de desarrollo · 0.3.6" Foreground="#9FB8BE" FontSize="11"/><TextBlock Text="3090, 5070 Ti y 5080 · escritorio" Foreground="#9FB8BE" FontSize="11" Margin="0,5,0,0"/></StackPanel>
      </Grid></ScrollViewer>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="StartButton" Content="Iniciar IA" Background="#087F70" Foreground="White" FontWeight="SemiBold" Click="Start_Click" IsEnabled="False"/><Button x:Name="StopButton" Content="Detener" Click="Stop_Click" IsEnabled="False"/><Button x:Name="CancelButton" Content="Cancelar" Click="Cancel_Click" Visibility="Collapsed"/></StackPanel><StackPanel><TextBlock x:Name="WorkspaceTitle" Text="Tu espacio para construir" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceDescription" Text="Archivos, herramientas y Git, con la IA en tu PC." Foreground="#9FB1BD" Margin="0,4,0,0"/></StackPanel></DockPanel>
      <Border Grid.Row="1" Background="#18232C" CornerRadius="10" Padding="16" Margin="0,0,0,18" BorderBrush="#2A3B47" BorderThickness="1"><StackPanel><TextBlock x:Name="StatusLabel" Text="Revisando el equipo..." FontWeight="SemiBold"/><TextBlock x:Name="DetailLabel" Foreground="#9FB1BD" FontSize="12" Margin="0,5,0,0"/><ProgressBar x:Name="Progress" Height="4" Margin="0,12,0,0" Visibility="Collapsed" Foreground="#087F70"/></StackPanel></Border>
      <Grid Grid.Row="2">
        <Border x:Name="WelcomePane" Background="#18232C" CornerRadius="14" Padding="32" BorderBrush="#2A3B47" BorderThickness="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="650" HorizontalAlignment="Left">
            <TextBlock Text="De una idea a un cambio en tu proyecto." FontSize="30" FontWeight="SemiBold" Margin="0,8,0,16"/>
            <TextBlock Text="Pedile que encuentre un error, cambie archivos o ejecute pruebas. El agente usa tu Git local y las instrucciones de cada repositorio." Foreground="#9FB1BD" FontSize="16"/>
            <Border Background="#132E30" CornerRadius="9" Padding="18" Margin="0,24,0,22"><StackPanel><TextBlock Text="La IA se descarga después de instalar" FontWeight="SemiBold"/><TextBlock x:Name="DownloadNote" Text="El modelo pesa unos 12,8 GB. Elegí dónde guardarlo: la descarga se puede reanudar y se verifica antes de usarla." Foreground="#A5C8C2" Margin="0,8,0,0"/></StackPanel></Border>
            <TextBlock Text="Modo del motor" FontWeight="SemiBold"/>
            <ComboBox x:Name="ModeChoice" SelectedIndex="0" SelectionChanged="ModeChoice_SelectionChanged" Padding="8" HorizontalAlignment="Left" MinWidth="420" Margin="0,8,0,6">
              <ComboBoxItem Content="Compatibilidad KVMem · modelo Swift"/>
              <ComboBoxItem Content="NInfer nativo Windows · modelo oficial de Todd"/>
            </ComboBox>
            <TextBlock x:Name="ModeHint" Foreground="#9FB1BD" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Button x:Name="NinferEngineButton" Content="Opcional: usar otro motor nativo" Click="ChooseNinferEngine_Click" Visibility="Collapsed" Margin="0,0,0,4"/>
            <Button x:Name="ResetNinferEngineButton" Content="Restaurar motor automático" Click="ResetNinferEngine_Click" Visibility="Collapsed" Margin="0,0,0,4"/>
            <TextBlock x:Name="NinferEngineLabel" Foreground="#9FB1BD" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
            <CheckBox x:Name="NinferVisionCheck" Visibility="Collapsed" Margin="0,2,0,10" Checked="NinferVision_Click" Unchecked="NinferVision_Click"><TextBlock Text="Activar visión (usa más VRAM)" Foreground="#E2ECF1"/></CheckBox>
            <TextBlock Text="Ubicación del modelo" FontWeight="SemiBold"/><TextBlock x:Name="ModelLocation" FontSize="12" Foreground="#9FB1BD" Margin="0,7,0,12"/>
            <WrapPanel><Button x:Name="ModelFolderButton" Content="Cambiar ubicación" Click="ChooseModelDirectory_Click"/><Button x:Name="ImportButton" Content="Usar modelo ya descargado" Click="Import_Click"/></WrapPanel>
            <TextBlock Text="Contexto de la conversación" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <ComboBox x:Name="ContextChoice" SelectedIndex="0" SelectionChanged="ContextChoice_SelectionChanged" Padding="8" HorizontalAlignment="Left" MinWidth="300"/>
            <TextBlock x:Name="ContextHint" Foreground="#9FB1BD" FontSize="11" Margin="0,8,0,0"/>
            <CheckBox x:Name="LicenseCheck" Margin="0,22,0,10" FontSize="13"><TextBlock Text="Revisé y acepto las licencias aplicables al modelo y los componentes."/></CheckBox>
            <TextBlock Margin="0,0,0,18" FontSize="12"><Hyperlink Click="Licenses_Click">Ver licencias y condiciones de uso</Hyperlink></TextBlock>
            <WrapPanel><Button x:Name="PrepareButton" Content="Preparar IA" Background="#087F70" Foreground="White" FontWeight="SemiBold" Click="Prepare_Click" IsEnabled="False"/></WrapPanel>
            <TextBlock x:Name="ModeFootnote" Text="La variante Swift tiene condiciones propias para uso comercial. La visión está desactivada para reservar memoria al código. La 5070 Ti todavía requiere validación física de esta aplicación." Foreground="#9FB1BD" FontSize="11" Margin="0,22,0,0"/>
          </StackPanel></ScrollViewer>
        </Border>
        <wv:WebView2 x:Name="Chat" Visibility="Collapsed"/>
        <Grid x:Name="VisualContainer" Visibility="Collapsed"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
